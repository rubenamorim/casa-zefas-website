{
  "name": "villa-zefas",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation vite dev --port 3000",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4000\" payload build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation payload migrate && node .output/server/index.mjs",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/payload/seed/index.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "4.0.0-beta.3",
    "@payloadcms/graphql": "4.0.0-beta.3",
    "@payloadcms/storage-s3": "4.0.0-beta.3",
    "@payloadcms/tanstack-start": "4.0.0-beta.3",
    "@payloadcms/transformer-sharp": "4.0.0-beta.3",
    "@payloadcms/translations": "4.0.0-beta.3",
    "@payloadcms/ui": "4.0.0-beta.3",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "cross-env": "^10.1.0",
    "graphql": "^16.14.2",
    "nitro": "3.0.260610-beta",
    "payload": "4.0.0-beta.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitejs/plugin-rsc": "^0.5.38",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
