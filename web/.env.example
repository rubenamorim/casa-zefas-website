# Postgres (local: docker container vz-pg, see README)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/villa_zefas
PAYLOAD_SECRET=change-me-long-random-string
# Public site origin — baked in at build time (canonical, hreflang, sitemap, og:image)
VITE_SITE_URL=https://casazefas.pt
# Seed only: editor account created by `pnpm seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Prod only (Railway bucket). Unset = local ./media
# BUCKET=
# ENDPOINT=
# REGION=
# ACCESS_KEY_ID=
# SECRET_ACCESS_KEY=
