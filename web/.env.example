# Where this server fetches content from (Railway private URL in prod)
CMS_URL=http://localhost:3001
# Where browsers load CMS images from (public CMS URL). Defaults to CMS_URL.
CMS_PUBLIC_URL=https://cms.casazefas.pt
# Public site origin — baked in at build time (canonical, hreflang, sitemap)
VITE_SITE_URL=https://casazefas.pt
